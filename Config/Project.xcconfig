// Set a unique reverse-domain identifier and your Apple Development Team before device installation.
CLEAR_BASE_BUNDLE_IDENTIFIER = com.example.clearkeyboard
// Match the group retained in the installed App and keyboard's signing entitlements.
// This is a container identifier, not a signing certificate or private key.
CLEAR_APP_GROUP = group.9e66ab897d52ea95.1
DEVELOPMENT_TEAM =
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = minimal
TARGETED_DEVICE_FAMILY = 1
SUPPORTS_MACCATALYST = NO
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = 0.1.84
CURRENT_PROJECT_VERSION = 87
ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
